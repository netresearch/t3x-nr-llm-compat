        <body>
            <trans-unit id="editorAction.create_news_draft.label">
                <source>Create news draft</source>
                <target>News-Artikel als Entwurf anlegen</target>
            </trans-unit>
            <trans-unit id="editorAction.create_news_draft.description">
                <source>Creates one hidden news article in a storage folder. A human makes it visible.</source>
                <target>Legt einen verborgenen News-Artikel in einem Datensatzordner an. Sichtbar schaltet ihn ein Mensch.</target>
            </trans-unit>
            <!-- Approval preview of create_news_draft -->
            <trans-unit id="approvalPreview.value.quoted">
                <source>“%s”</source>
                <target>„%s“</target>
            </trans-unit>
            <trans-unit id="approvalPreview.value.empty">
                <source>(empty)</source>
                <target>(leer)</target>
            </trans-unit>
            <trans-unit id="approvalPreview.value.notGiven">
                <source>(not given)</source>
                <target>(nicht angegeben)</target>
            </trans-unit>
            <trans-unit id="approvalPreview.createNews.heading">
                <source>Create news article as draft</source>
                <target>Neuen News-Artikel als Entwurf anlegen</target>
            </trans-unit>
            <trans-unit id="approvalPreview.createNews.location">
                <source>Location: in the folder %s</source>
                <target>Ort: im Ordner %s</target>
            </trans-unit>
            <trans-unit id="approvalPreview.createNews.title">
                <source>Title: %s</source>
                <target>Titel: %s</target>
            </trans-unit>

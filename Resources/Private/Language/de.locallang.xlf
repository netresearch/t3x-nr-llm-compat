                <source>Teaser: %s</source>
                <target>Teaser: %s</target>
            </trans-unit>
            <trans-unit id="approvalPreview.createNews.text">
                <source>Article text: %s</source>
                <target>Artikeltext: %s</target>
            </trans-unit>
            <trans-unit id="approvalPreview.createNews.date">
                <source>Date: %s</source>
                <target>Datum: %s</target>
            </trans-unit>
            <trans-unit id="approvalPreview.createNews.dateFormat">
                <source>Y-m-d H:i (e)</source>
                <target>d.m.Y, H:i (e)</target>
            </trans-unit>
            <trans-unit id="approvalPreview.createNews.author">
                <source>Author: %s</source>
                <target>Autor: %s</target>
            </trans-unit>
            <trans-unit id="approvalPreview.createNews.description">
                <source>Meta description: %s</source>
                <target>Meta Description: %s</target>
            </trans-unit>
            <trans-unit id="approvalPreview.createNews.urlPath">
                <source>URL path: generated from the title</source>
                <target>URL-Pfad: wird aus dem Titel erzeugt</target>
            </trans-unit>
            <trans-unit id="approvalPreview.createNews.type">
                <source>Type: article with its own text</source>
                <target>Typ: Artikel mit eigenem Text</target>
            </trans-unit>
            <trans-unit id="approvalPreview.createNews.language">
                <source>Language: default language</source>
                <target>Sprache: Standardsprache</target>
            </trans-unit>
            <trans-unit id="approvalPreview.createNews.visibility">
                <source>Visibility: hidden at first</source>
                <target>Sichtbarkeit: zunächst verborgen</target>
            </trans-unit>
            <trans-unit id="approvalPreview.createNews.notSet">
                <source>Not set: categories, images and media, tags, related articles, links and files. They are added in the backend afterwards.</source>
                <target>Nicht gesetzt: Kategorien, Bilder und Medien, Tags, verwandte Artikel, Links und Dateien. Diese werden danach im Backend ergänzt.</target>
            </trans-unit>
            <trans-unit id="approvalPreview.createNews.impact">
                <source>After it is created the article is not publicly visible yet. It has to be made visible by a person.</source>
                <target>Der Artikel ist nach dem Anlegen noch nicht öffentlich sichtbar. Er muss erst von einer Person sichtbar gemacht werden.</target>
            </trans-unit>
